---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lead?: string;
}

const { id, eyebrow, title, lead } = Astro.props;
---

<header class="heading">
  <p class="label eyebrow">{eyebrow}</p>
  <h2 id={id}>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
</header>

<style>
  .heading {
    margin-bottom: clamp(2.5rem, 6vw, 3.5rem);
  }

  .eyebrow {
    color: var(--accent);
  }

  h2 {
    margin-top: 1rem;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .lead {
    margin-top: 1.25rem;
    max-width: 40rem;
    color: var(--muted);
    font-size: 1.125rem;
  }
</style>
