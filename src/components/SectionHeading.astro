---
interface Props {
  id: string;
  index: string;
  eyebrow: string;
  title: string;
  lead?: string;
}

const { id, index, eyebrow, title, lead } = Astro.props;
---

<header class="heading">
  <p class="eyebrow mono">
    {index} / {eyebrow}
  </p>
  <h2 id={id}>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
</header>

<style>
  .heading {
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    margin-top: 0.75rem;
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  /* The short mint rule under every slide title in the deck. */
  h2::after {
    content: "";
    display: block;
    width: 3.5rem;
    height: 3px;
    margin-top: 1.25rem;
    border-radius: 2px;
    background: var(--accent);
  }

  .lead {
    margin-top: 1.25rem;
    max-width: 40rem;
    color: var(--muted);
    font-size: 1.0625rem;
  }
</style>
