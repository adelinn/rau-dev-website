---
import { club } from "../data/content";
import Icon from "./Icon.astro";

const lastLine = club.tagline.length - 1;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container grid">
    <div>
      <p class="label university">{club.university}</p>
      <h1 id="hero-title">
        <span class="wordmark">
          RAU <span class="dev">DEV</span>
          <svg
            class="glyph"
            viewBox="0 0 48 32"
            fill="none"
            stroke="currentColor"
            stroke-width="4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 6 2 16l10 10M36 6l10 10-10 10M28 3l-8 26"></path>
          </svg>
        </span>
        <span class="label subtitle">{club.label}</span>
      </h1>
      <p class="tagline">
        {club.tagline.map((line, i) => (
          <span class:list={{ highlight: i === lastLine }}>{line}</span>
        ))}
      </p>
      <p class="description">{club.description}</p>
      <div class="actions">
        <a class="button primary" href="#join">
          Join RAU DEV <Icon name="arrow" size={18} />
        </a>
        <a class="button" href="#challenges">
          Try a challenge
        </a>
      </div>
    </div>

    <figure class="editor" aria-label="The club motto, written as code">
      <div class="bar" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
        <p class="file">club.js</p>
      </div>
      <pre><code><span class="kw">while</span> (<span class="var">curious</span>) {"{"}
  <span class="fn">learn</span>();
  <span class="fn">build</span>();
  <span class="fn">share</span>();
{"}"}<span class="cursor" aria-hidden="true"></span></code></pre>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 9vw, 6.5rem) clamp(4rem, 9vw, 6rem);
    background:
      radial-gradient(
        60rem 30rem at 85% -10%,
        rgb(114 246 205 / 0.07),
        transparent 60%
      ),
      var(--bg);
  }

  .grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  .university {
    color: var(--muted);
  }

  h1 {
    margin-top: 1.25rem;
    font-size: clamp(2.75rem, 12vw, 5.75rem);
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.25em;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .dev {
    color: var(--accent);
  }

  .glyph {
    flex: none;
    width: 0.6em;
    color: var(--accent);
  }

  .subtitle {
    display: block;
    margin-top: 1rem;
    color: var(--text);
    font-size: clamp(0.75rem, 2.2vw, 1.0625rem);
    font-weight: 500;
    letter-spacing: 0.42em;
    line-height: 1.4;
  }

  /* Short mint rule from the poster, between the club name and the tagline. */
  .tagline::before {
    content: "";
    display: block;
    width: 4.5rem;
    height: 4px;
    margin-bottom: 2rem;
    border-radius: 2px;
    background: var(--accent);
  }

  .tagline {
    margin-top: 2rem;
    font-size: clamp(2rem, 5.5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .tagline span {
    display: block;
  }

  .highlight {
    color: var(--accent);
  }

  .description {
    margin-top: 1.5rem;
    max-width: 32rem;
    color: var(--muted);
    font-size: 1.1875rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.4rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  .button:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  .button.primary:hover {
    background: var(--accent-soft);
    border-color: var(--accent-soft);
  }

  .editor {
    margin: 0;
    overflow: hidden;
    background: #04121e;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.7);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.9rem 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .bar span {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: #ff5f57;
  }

  .bar span:nth-child(2) {
    background: #febc2e;
  }

  .bar span:nth-child(3) {
    background: #28c840;
  }

  .file {
    margin-left: auto;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  pre {
    margin: 0;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    overflow-x: auto;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2.4vw, 1.25rem);
    font-weight: 500;
    line-height: 1.8;
  }

  .kw {
    color: var(--pink);
  }

  .var {
    color: var(--blue);
  }

  .fn {
    color: var(--accent);
  }

  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 0.15em;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
