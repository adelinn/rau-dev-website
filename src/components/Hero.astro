---
import { club } from "../data/content";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container grid">
    <div class="copy">
      <p class="university mono">{club.university}</p>
      <h1 id="hero-title" class="wordmark">
        RAU <span>DEV</span>
      </h1>
      <p class="tagline">
        {club.tagline.map((line) => (
          <span>{line}</span>
        ))}
      </p>
      <p class="description">{club.description}</p>
      <div class="actions">
        <a class="button primary" href="#challenges">
          Try a challenge
        </a>
        <a class="button" href="#join">
          Get involved
        </a>
      </div>
    </div>

    <figure class="code-card" aria-label="The club motto, written as code">
      <p class="card-label mono">01 // welcome</p>
      <pre class="mono"><code><span class="kw">while</span> (curious) {"{"}
  <span class="fn">learn</span>();
  <span class="fn">build</span>();
  <span class="fn">share</span>();
{"}"}<span class="cursor" aria-hidden="true"></span></code></pre>
      <p class="glyph mono" aria-hidden="true">
        &lt;/&gt;
      </p>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 10vw, 7rem) clamp(4rem, 10vw, 6rem);
    background:
      radial-gradient(
        60rem 30rem at 85% -10%,
        rgb(37 230 187 / 0.08),
        transparent 60%
      ),
      var(--bg);
  }

  .grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  @media (min-width: 52rem) {
    .grid {
      grid-template-columns: 1.3fr 1fr;
    }
  }

  .university {
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .wordmark {
    margin-top: 1.5rem;
    font-size: clamp(3.5rem, 12vw, 6.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .wordmark span {
    color: var(--accent);
  }

  .tagline {
    margin-top: 2rem;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    line-height: 1.3;
  }

  .tagline span {
    display: block;
  }

  .description {
    margin-top: 1.5rem;
    max-width: 30rem;
    color: var(--muted);
    font-size: 1.0625rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  .button:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  .button.primary:hover {
    background: var(--accent-soft);
    border-color: var(--accent-soft);
    color: var(--bg);
  }

  .code-card {
    margin: 0;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6);
  }

  .card-label {
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  pre {
    margin: 1.5rem 0 0;
    overflow-x: auto;
    color: var(--accent-soft);
    font-size: clamp(1rem, 2.4vw, 1.25rem);
    font-weight: 600;
    line-height: 1.7;
  }

  .kw {
    color: var(--accent);
  }

  .fn {
    color: var(--text);
  }

  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 0.15em;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .glyph {
    margin-top: 2.5rem;
    color: var(--accent);
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
  }
</style>
