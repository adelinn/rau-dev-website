---
import Footer from "../components/Footer.astro";
import Base from "../layouts/Base.astro";
---

<Base title="Page not found · RAU DEV">
  <main id="main" class="container not-found">
    <p class="mono code">404 // not found</p>
    <h1>This route isn’t built yet.</h1>
    <a href="/">Back to the homepage</a>
  </main>
  <Footer />
</Base>

<style>
  .not-found {
    display: grid;
    align-content: center;
    gap: 1.25rem;
    min-height: 70vh;
  }

  .code {
    color: var(--accent);
    font-weight: 600;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
  }
</style>
